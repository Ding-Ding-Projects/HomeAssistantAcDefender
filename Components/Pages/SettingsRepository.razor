@page "/settings/repository"
@page "/repository"
@using System.Text.RegularExpressions
@inject DefenderStateStore StateStore
@inject AcDefenderService Defender
@inject SettingsRepositoryHistoryExportService ExportService
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Settings Repository — SCP AC Defender</PageTitle>

<div class="ops-dash-stack">

    @* ── repo status bar ── *@
    <div class="ops-repo-bar">
        <div class="ops-repo-bar__icon" aria-hidden="true">⇄</div>
        <div class="ops-repo-bar__id">
            <h2 class="ops-repo-bar__title">@RepoName <span class="ops-repo-bar__origin">· @(_repo?.RepositoryPath ?? "local settings repository")</span></h2>
            <div class="ops-repo-chips">
                <span class="ops-repo-chip ops-repo-chip--branch">⎇ @BranchText</span>
                @if (_repo is { Clean: false })
                {
                    <span class="ops-repo-chip ops-repo-chip--dirty">● @(_repo.Files.Count) FILE@(_repo.Files.Count == 1 ? "" : "S") MODIFIED</span>
                }
                else
                {
                    <span class="ops-repo-chip ops-repo-chip--clean">✓ CLEAN</span>
                }
                <span class="ops-repo-chip">@(_repo?.History.Count ?? 0) COMMITS</span>
                <span class="ops-repo-chip">HEAD @HeadShort</span>
            </div>
        </div>
        <div class="ops-repo-actions">
            <button class="ops-btn" @onclick="Refresh">⟳ REFRESH</button>
            <button class="ops-btn ops-btn--outline" @onclick="CommitNow">⇡ COMMIT SNAPSHOT</button>
            <button class="ops-btn ops-btn--outline" disabled="@(_repo is null)" @onclick="ExportHistoryJson">⇩ EXPORT JSON</button>
            <button class="ops-btn ops-btn--outline" disabled="@(_repo is null)" @onclick="ExportHistoryMarkdown">⇩ EXPORT MARKDOWN</button>
            <button class="ops-btn ops-btn--danger" disabled="@(!CanUndo)" @onclick="UndoLast">↺ UNDO LAST</button>
        </div>
    </div>

    @if (_repo?.Error is { Length: > 0 } error)
    {
        <div class="ops-alert-row ops-alert-row--bad">
            <span class="ops-alert-row__glyph" aria-hidden="true">⚠</span>
            <span class="ops-alert-row__tag">GIT</span>
            <span class="ops-alert-row__text">@error</span>
        </div>
    }
    else if (_repo is { Available: false } or { Initialized: false })
    {
        <div class="ops-alert-row ops-alert-row--warn">
            <span class="ops-alert-row__glyph" aria-hidden="true">◔</span>
            <span class="ops-alert-row__tag">STATUS</span>
            <span class="ops-alert-row__text">@RepoStatus</span>
        </div>
    }

    <div class="ops-repo-grid">
        @* ── left: uncommitted changes + commit ── *@
        <div class="@(_repo is { Clean: false } ? "ops-panel ops-panel--pad ops-repo-pending ops-repo-pending--dirty" : "ops-panel ops-panel--pad ops-repo-pending")">
            <h2 class="ops-panel__label" style="@(_repo is { Clean: false } ? "color: var(--warn);" : "")">UNCOMMITTED STANDING-ORDER CHANGES — settings.json</h2>
            @if (_repo is { Clean: false, Files.Count: > 0 })
            {
                <pre class="ops-repo-diff">@foreach (var file in _repo.Files)
{<span class="ops-repo-diff__line ops-repo-diff__line--@DiffKind(file.Code)">@file.Code  @file.Path
</span>}</pre>
                <input class="ops-input ops-commit-input" value="@_commitMessage" @oninput="OnCommitMessageChanged"
                       placeholder="Commit message… (be honest, git remembers)" aria-label="Commit message" />
                <button class="ops-commit-btn" @onclick="CommitWithMessage">⇡ COMMIT &amp; SAVE</button>
            }
            else
            {
                <div class="ops-repo-clean">
                    Working tree clean. ✨<br />
                    Every standing order matches HEAD. The guards find this deeply satisfying.
                </div>
            }
        </div>

        @* ── right: commit history ── *@
        <div class="ops-panel ops-panel--pad" style="min-width: 0;">
            <h2 class="ops-panel__label">COMMIT HISTORY — ⎇ @BranchText</h2>
            <input class="ops-input" style="width: 100%; box-sizing: border-box; margin: 0 0 10px 0;"
                   value="@_historySearch" @oninput="OnHistorySearchChanged"
                   placeholder="SEARCH COMMITS…" aria-label="Search commits" />
            <RegexSearchBuilder Id="history-search" Value="@_historySearch" ValueChanged="SetHistorySearch"
                                Mode="@_historySearchMode" ModeChanged="SetHistorySearchMode"
                                Flags="@_historySearchFlags" FlagsChanged="SetHistorySearchFlags" />
            <div class="notification-history-date-filter" aria-label="Settings history date range filters">
                <label>Start date (UTC, YYYY-MM-DD)
                    <input class="ops-input" type="text" inputmode="numeric" value="@_startDate" @oninput="OnStartDateChanged" placeholder="YYYY-MM-DD" aria-label="Settings history start date in UTC" />
                </label>
                <label>End date (UTC, YYYY-MM-DD)
                    <input class="ops-input" type="text" inputmode="numeric" value="@_endDate" @oninput="OnEndDateChanged" placeholder="YYYY-MM-DD" aria-label="Settings history end date in UTC" />
                </label>
                <label>Preset
                    <select class="ops-input" value="@_datePreset" @onchange="OnDatePresetChanged" aria-label="Settings history date range preset">
                        <option value="">All dates</option>
                        <option value="today">Today</option>
                        <option value="7d">Last 7 days</option>
                        <option value="30d">Last 30 days</option>
                        <option value="90d">Last 90 days</option>
                        <option value="month">This month</option>
                    </select>
                </label>
            </div>
            @if (DateFilterError is not null)
            {
                <div class="notification-history-filter-error" role="alert">@DateFilterError</div>
            }
            @if (ActionKinds.Count > 0)
            {
                <fieldset class="notification-history-actions">
                    <legend>Filter by history action (counts are derived from the stored Git history)</legend>
                    @foreach (var action in ActionKinds)
                    {
                        <label class="notification-history-check">
                            <input type="checkbox" checked="@_actionFilter.Contains(action)" @onchange="@(args => OnActionChanged(action, args))" />
                            @action <span class="notification-history-action-count">(@ActionCounts[action])</span>
                        </label>
                    }
                </fieldset>
            }
            <div class="ops-commit-list">
                @if (FilteredHistory.Count > 0)
                {
                    @for (var i = 0; i < FilteredHistory.Count; i++)
                    {
                        var commit = FilteredHistory[i];
                        var newest = i == 0
                            && string.IsNullOrWhiteSpace(_historySearch)
                            && string.IsNullOrWhiteSpace(_startDate)
                            && string.IsNullOrWhiteSpace(_endDate)
                            && _actionFilter.Count == 0;
                        <div class="@(newest ? "ops-commit-row ops-commit-row--newest" : "ops-commit-row")">
                            <div class="ops-commit-row__top">
                                <span class="ops-commit-row__hash">@commit.ShortHash</span>
                                <span class="ops-commit-row__msg">@commit.Message</span>
                                <span class="ops-commit-row__when">@CommitWhen(commit)</span>
                            </div>
                            <div class="ops-commit-row__meta">
                                settings.json snapshot · @SettingsRepositoryHistoryFilters.ActionFor(commit)
                                @if (CanRestore)
                                {
                                    <button class="ops-commit-row__restore" @onclick="@(() => Restore(commit))">↩ restore</button>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="helper-text">No settings commits match.</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private SettingsRepositoryState? _repo;
    private string _historySearch = "";
    private string _historySearchMode = "plain";
    private string _historySearchFlags = "im";
    private string _startDate = "";
    private string _endDate = "";
    private string _datePreset = "";
    private readonly HashSet<string> _actionFilter = new(StringComparer.OrdinalIgnoreCase);
    private string _commitMessage = "";

    protected override void OnInitialized() => Refresh();

    private void Refresh() => _repo = StateStore.GetSettingsRepositoryState();

    private void OnHistorySearchChanged(ChangeEventArgs e) => _historySearch = e.Value?.ToString() ?? "";
    private void OnCommitMessageChanged(ChangeEventArgs e) => _commitMessage = e.Value?.ToString() ?? "";
    private void OnStartDateChanged(ChangeEventArgs e) { _startDate = e.Value?.ToString() ?? ""; _datePreset = ""; }
    private void OnEndDateChanged(ChangeEventArgs e) { _endDate = e.Value?.ToString() ?? ""; _datePreset = ""; }

    private void OnDatePresetChanged(ChangeEventArgs e)
    {
        _datePreset = e.Value?.ToString() ?? "";
        (_startDate, _endDate) = SettingsRepositoryHistoryFilters.ResolvePreset(
            _datePreset,
            DateOnly.FromDateTime(DateTime.UtcNow));
    }

    private void OnActionChanged(string action, ChangeEventArgs e)
    {
        if (e.Value is bool selected && selected)
        {
            _actionFilter.Add(action);
        }
        else
        {
            _actionFilter.Remove(action);
        }
    }

    private Task SetHistorySearch(string value)
    {
        _historySearch = value;
        return Task.CompletedTask;
    }

    private Task SetHistorySearchMode(string value)
    {
        _historySearchMode = value;
        return Task.CompletedTask;
    }

    private Task SetHistorySearchFlags(string value)
    {
        _historySearchFlags = value;
        return Task.CompletedTask;
    }

    private void CommitNow()
    {
        ShowResult(StateStore.CommitSettingsRepositorySnapshot("Manual settings repository snapshot"));
        Refresh();
    }

    private void CommitWithMessage()
    {
        var message = string.IsNullOrWhiteSpace(_commitMessage)
            ? "tweak standing orders (no comment. do not ask.)"
            : _commitMessage.Trim();
        ShowResult(StateStore.CommitSettingsRepositorySnapshot(message));
        _commitMessage = "";
        Refresh();
    }

    private async Task UndoLast()
    {
        ShowResult(await Defender.UndoLastSettingsRepositoryCommitAsync(CancellationToken.None));
        Refresh();
    }

    private async Task Restore(SettingsRepositoryCommit commit)
    {
        ShowResult(await Defender.RestoreSettingsRepositoryCommitAsync(commit.Hash, CancellationToken.None));
        Refresh();
    }

    private void ShowResult(SettingsRepositoryActionResult result) =>
        Snackbar.Add(result.Message, result.Success ? Severity.Success : Severity.Warning);

    private IReadOnlyList<SettingsRepositoryCommit> CandidateHistory =>
        SettingsRepositoryHistoryFilters.Filter(
            _repo?.History ?? [],
            "",
            "plain",
            "im",
            [],
            _startDate,
            _endDate);

    private IReadOnlyDictionary<string, int> ActionCounts =>
        CandidateHistory
            .GroupBy(SettingsRepositoryHistoryFilters.ActionFor, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<string> ActionKinds =>
        ActionCounts.Keys.OrderBy(action => action, StringComparer.OrdinalIgnoreCase).ToArray();

    private IReadOnlyList<SettingsRepositoryCommit> FilteredHistory =>
        SettingsRepositoryHistoryFilters.Filter(
            _repo?.History ?? [],
            _historySearch,
            _historySearchMode,
            _historySearchFlags,
            _actionFilter,
            _startDate,
            _endDate);

    private string? DateFilterError => SettingsRepositoryHistoryFilters.DateRangeError(_startDate, _endDate);

    private bool CanUndo => _repo is { Available: true, Initialized: true, Clean: true, History.Count: > 1 };
    private bool CanRestore => _repo is { Available: true, Initialized: true, Clean: true };

    private string RepoName => _repo?.RepositoryPath is { Length: > 0 } path
        ? System.IO.Path.GetFileName(path.TrimEnd('/', '\\')) + ".git"
        : "acdefender-settings.git";

    private string RepoStatus => _repo?.Status ?? "Loading";
    private string BranchText => string.IsNullOrWhiteSpace(_repo?.Branch) ? "main" : _repo.Branch;
    private string HeadShort => string.IsNullOrWhiteSpace(_repo?.Head) ? "—" : _repo.Head;

    private static string DiffKind(string code) => code.Trim() switch
    {
        "A" or "??" => "add",
        "D" => "del",
        _ => "ctx"
    };

    private static string CommitWhen(SettingsRepositoryCommit commit) =>
        DateTimeOffset.TryParse(commit.Timestamp, out var parsed) ? Format.RelativeTime(parsed) : commit.Timestamp;

    private Task ExportHistoryJson() => ExportHistoryAsync(
        "json",
        "application/json;charset=utf-8",
        (commits, filters) => ExportService.ToJson(commits, filters));

    private Task ExportHistoryMarkdown() => ExportHistoryAsync(
        "md",
        "text/markdown;charset=utf-8",
        (commits, filters) => ExportService.ToMarkdown(commits, filters));

    private async Task ExportHistoryAsync(
        string extension,
        string mimeType,
        Func<IReadOnlyList<SettingsRepositoryCommit>, SettingsRepositoryHistoryExportFilters, byte[]> build)
    {
        var commits = FilteredHistory;
        var filters = new SettingsRepositoryHistoryExportFilters(
            _historySearch,
            _historySearchMode,
            _historySearchFlags,
            _startDate,
            _endDate,
            _actionFilter.OrderBy(action => action, StringComparer.OrdinalIgnoreCase).ToArray());
        try
        {
            var bytes = build(commits, filters);
            var timestamp = DateTimeOffset.UtcNow.ToString("yyyyMMdd-HHmmss");
            var fileName = $"ac-defender-settings-history-{timestamp}.{extension}";
            await JS.InvokeVoidAsync(
                "acDefenderNotificationExport.downloadBase64",
                fileName,
                mimeType,
                Convert.ToBase64String(bytes));
            Snackbar.Add($"Exported {commits.Count} filtered settings commits as {extension.ToUpperInvariant()}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Settings history export failed: {ex.Message}", Severity.Error, options => options.RequireInteraction = true);
        }
    }
}
