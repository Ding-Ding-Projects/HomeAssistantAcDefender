# Development-only loopback placeholder. Production must replace this with the real HTTPS API URL.
HomeAssistant__BaseUrl=http://127.0.0.1:8123
# Keep false unless the production Home Assistant endpoint is a private RFC1918/link-local/.local HTTP target.
HomeAssistant__AllowInsecurePrivateNetworkHttp=false
HomeAssistant__EntityId=climate.dining_room
HomeAssistant__WeatherEntityId=
HomeAssistant__OutdoorTemperatureEntityId=
# Key-free real-weather backup. Coordinates default to Home Assistant /api/config.
HomeAssistant__OpenMeteoBackupEnabled=true
HomeAssistant__OpenMeteoLatitude=
HomeAssistant__OpenMeteoLongitude=
HomeAssistant__OpenMeteoRefreshMinutes=30
HomeAssistant__UsagePowerEntityId=sensor.alectra_hui_current_power
HomeAssistant__UsageEnergyEntityId=sensor.alectra_hui_energy_today
HomeAssistant__UsageCostEntityId=sensor.alectra_hui_cost_today
HomeAssistant__UsageHourlyCostEntityId=sensor.alectra_hui_hourly_cost
HomeAssistant__UsageCurrentBillEntityId=sensor.alectra_hui_current_bill
HomeAssistant__UsageCurrentBillDueEntityId=sensor.alectra_hui_current_bill_due
HomeAssistant__UsageCurrentBillStatusEntityId=sensor.alectra_hui_current_bill_status
HomeAssistant__AccessToken=replace-with-home-assistant-long-lived-token
HomeAssistant__Username=replace-with-home-assistant-username
HomeAssistant__Password=replace-with-home-assistant-password

# Compose/reverse-proxy trust boundary. Replace the development values with the exact proxy IP
# or CIDR and public host names used by production; at least one of the two trust lists is required.
FORWARDED_HEADERS_KNOWN_PROXIES=127.0.0.1
FORWARDED_HEADERS_KNOWN_IP_NETWORKS=
FORWARDED_HEADERS_ALLOWED_HOSTS=localhost
Defender__PollIntervalSeconds=5
Defender__CommandGraceSeconds=120
TwoFactor__Secret=

# Optional "Sign in with Google" (device flow — works on plain-HTTP LAN addresses).
# Create an OAuth client of type "TVs and Limited Input devices" in Google Cloud Console,
# then allow-list the Google account email(s) that may sign in.
Auth__GoogleClientId=
Auth__GoogleClientSecret=
Auth__GoogleAllowedEmails=

# Optional Nest doorbell live view at /camera (SDM WebRTC bridge).
# Refresh token comes from the one-time SDM consent; device name from the SDM devices list.
Sdm__ClientId=
Sdm__ClientSecret=
Sdm__RefreshToken=
Sdm__DoorbellDevice=

# Energy kiosk: cast the unbranded Energy dashboard to a Google display 24/7.
Kiosk__Enabled=false
Kiosk__MediaPlayerEntity=

# Wake-Up Truce: bedroom door sensor that pre-warms the target at dawn.
Defender__WakeTruceDoorSensorEntityId=
Defender__WakeTruceWindowStart=04:00
Defender__WakeTruceWindowEnd=09:00
Defender__WakeTruceTargetCelsius=25.0
Defender__WakeTruceHoldMinutes=120
